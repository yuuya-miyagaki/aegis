{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-gate.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/check-tdd.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/check-client-info.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-control-plane.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/check-destructive.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/check-secrets.sh"
          },
          {
            "type": "command",
            "command": "bash hooks/check-deploy-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Vercel__deploy_to_vercel",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-deploy-mcp-gate.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-skill-gate.sh"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-cron-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/post-status-audit.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/post-bash.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-task-created.sh"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-task-completed.sh"
          }
        ]
      }
    ]
  }
}
